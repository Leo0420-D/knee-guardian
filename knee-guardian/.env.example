# -----------------------------------------------------------------------------
# 讯飞星火（Spark）API 凭据模板
#
# 用法：复制本文件为同目录下的 .env，填入自己的凭据。
#       .env 已被 .gitignore 忽略，不会进入仓库 —— 请务必不要把真实凭据提交上去。
#
# 获取地址：https://console.xfyun.cn/  ->  我的应用  ->  APPID / APIKey / APISecret
# -----------------------------------------------------------------------------

SPARK_APPID=
SPARK_API_KEY=
SPARK_API_SECRET=

# 以下两项有默认值，通常无需修改
# SPARK_URL=wss://spark-api.xf-yun.com/v4.0/chat
# SPARK_DOMAIN=4.0Ultra
